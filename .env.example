# --- Discord ---
# Token del bot (Bot -> Reset Token en el Developer Portal). NUNCA subir a Git.
DISCORD_TOKEN=
# Application ID (General Information en el Developer Portal).
DISCORD_APPLICATION_ID=
# ID del servidor de pruebas. Si esta definido, los slash commands se registran
# a nivel de servidor (propagacion inmediata). Sin definir, /deploy:commands
# los registra globalemente (tarda hasta 1 h en propagarse).
DEVBOT_GUILD_ID=

# --- Autorizacion (allowlist, fail-closed) ---
# IDs numericos de usuarios de Discord autorizados, separados por comas.
# Obligatorio: si esta vacio, ningun usuario puede usar el bot.
DEVBOT_ALLOWED_USER_IDS=
# IDs de servidores permitidos, separados por comas. Opcional: si esta vacio
# se permite cualquier servidor donde el bot este presente.
DEVBOT_ALLOWED_GUILD_IDS=

# --- Notificaciones (Iteracion 4) ---
DEVBOT_NOTIFICATION_CHANNEL_ID=

# --- Modulo de feedback: /bug y /suggest hacia GitHub backlog ---
# Pendiente de credenciales: si falta cualquiera de las 3 obligatorias,
# el modulo se deshabilita con un aviso en el arranque y el bot sigue
# funcionando con /help y /status.
# Token de GitHub con permisos Issues: Read & Write sobre el repo.
# Recomendado: fine-grained PAT limitado a DEVBOT_GITHUB_REPO. Necesita
# ademas poder subir assets a `uploads.github.com/user-attachments` (las
# capturas de los posts): si el upload devuelve 401/403 con fine-grained,
# usa un classic PAT o un GitHub App.
DEVBOT_GITHUB_TOKEN=
# Backlog en formato owner/repo, ej: Indie-Modding-Games/dw-bot-backlog
DEVBOT_GITHUB_REPO=
# ID de GraphQL del proyecto GitHub (Projects v2) donde asignar cada issue
# creada o actualizada (ej: PVT_kwDOABC...). Obtenerlo con
# scripts/debug-github-projects.mjs. Vacio = no asignar a proyecto.
DEVBOT_GITHUB_PROJECT_ID=
# Canal de Discord donde el bot publica las fichas y las actualiza/edita
# cuando cambia el estado de la issue. El bot necesita en ese canal:
# View Channel, Send Messages y Embed Links.
DEVBOT_FEEDBACK_CHANNEL_ID=
# Frecuencia de sondeo de cambios en GitHub (node-cron). Cada 5 min por defecto.
# Alternativa futura: webhook de GitHub si el bot queda expuesto publicamente.
DEVBOT_FEEDBACK_CRON=*/5 * * * *
# Etiquetas aplicadas al crear cada tipo de issue (CSV).
DEVBOT_BUG_LABELS=bug
DEVBOT_SUGGESTION_LABELS=enhancement
# Direccion donde se guarda el seguimiento de issues sincronizadas
# (feedback.json). Migrara a SQLite en la Iteracion 2.
DEVBOT_DATA_DIR=data

# --- Ingestion desde canales de FORO de Discord (posts -> tickets) ---
# PENDIENTE: IDs de los dos canales de foro (clic derecho al canal ->
# Copiar ID). El bot necesita en esos foros: View Channel, Send Messages,
# Send Messages In Threads, Read Message History y Manage Threads.
# Foro de propuestas: solo posts con la etiqueta REQUIRED_TAG entran al
# backlog; cuando la issue llega a done (cerrada como completada) el bot
# le cambia la etiqueta al post (quita REQUIRED_TAG, pone DONE_TAG).
# IMPORTANTE: los nombres deben coincidir EXACTAMENTE con las etiquetas del
# foro, incluidos emojis y prefijos (p. ej. "🟡 En revisión"). Si no, el bot
# avisa en el log con la lista de etiquetas disponibles.
DEVBOT_FEEDBACK_PROPOSALS_CHANNEL_ID=
DEVBOT_PROPOSALS_REQUIRED_TAG=Aceptado
DEVBOT_PROPOSALS_DONE_TAG=Implementado
# Foro de bugs: solo posts con REQUIRED_TAG entran al backlog. DONE_TAG es
# opcional: si se define, tambien cambia la etiqueta del post al llegar a done.
DEVBOT_FEEDBACK_BUGS_CHANNEL_ID=
DEVBOT_BUGS_REQUIRED_TAG=🟡 En revisión
DEVBOT_BUGS_DONE_TAG=

# --- Observabilidad ---
# fatal | error | warn | info | debug | trace
DEVBOT_LOG_LEVEL=info
# 1 para logs legibles en desarrollo (usa pino-pretty).
DEVBOT_PRETTY_LOGS=1
