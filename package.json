{
  "name": "devbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DevBot - herramienta personal de automatizacion para desarrollo (bot de Discord primero)",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "deploy:commands": "tsx src/infrastructure/discord/deploy-commands.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "simple-git": "^4.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
